{
  "type": "object",
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "challenge": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "hashes": {
          "type": "object",
          "properties": {
            "definition": {"type": "string"},
            "environment": {"type": "string"},
            "scorecard": {"type": "string"}
          },
          "required": ["definition", "environment", "scorecard"],
          "additionalProperties": false
        }
      },
      "required": ["id", "version", "hashes"],
      "additionalProperties": false
    },
    "solution": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "runtime": {"type": "string", "minLength": 1},
        "manifest_digest": {"type": "string", "minLength": 1}
      },
      "required": ["id", "name", "version", "runtime", "manifest_digest"],
      "additionalProperties": false
    },
    "seed": {"type": "integer", "minimum": 0},
    "started_at": {"type": "string", "minLength": 1},
    "finished_at": {"type": "string", "minLength": 1},
    "duration_seconds": {"type": "number", "minimum": 0},
    "termination_reason": {"enum": ["completed", "solution_failed", "timeout", "protocol_error", "engine_error"]},
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "source": {"enum": ["engine", "environment", "candidate", "verification"]},
          "timestamp": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "data": {"type": "object"}
        },
        "required": ["id", "source", "timestamp", "kind", "data"],
        "additionalProperties": false
      }
    },
    "snapshots": {
      "type": "object",
      "properties": {"initial": {"type": "object"}, "final": {"type": "object"}},
      "required": ["initial", "final"],
      "additionalProperties": false
    },
    "checks": {"type": "object"},
    "submission": {"anyOf": [{"$ref": "submission.schema.json"}, {"type": "null"}]}
  },
  "required": [
    "schema_version",
    "run_id",
    "challenge",
    "solution",
    "seed",
    "started_at",
    "finished_at",
    "duration_seconds",
    "termination_reason",
    "events",
    "snapshots",
    "checks",
    "submission"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
