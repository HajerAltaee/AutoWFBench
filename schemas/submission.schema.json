{
  "type": "object",
  "properties": {
    "protocol_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "completed",
        "failed"
      ]
    },
    "final_answer": {
      "type": "string"
    },
    "artifacts": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          },
          "content": {
            "type": "string",
            "maxLength": 200000
          }
        },
        "required": [
          "name",
          "media_type",
          "content"
        ],
        "additionalProperties": false
      }
    },
    "trace": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "data": {
            "type": "object"
          }
        },
        "required": [
          "timestamp",
          "kind",
          "data"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "protocol_version",
    "run_id",
    "status",
    "final_answer",
    "artifacts",
    "trace"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
