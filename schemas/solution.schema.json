{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "endpoint": {
      "type": "string",
      "pattern": "^https?://"
    },
    "runtime": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "auth_env": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "version",
    "endpoint",
    "runtime",
    "description",
    "auth_env"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
